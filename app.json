{
  "expo": {
    "name": "Cypris Smile",
    "slug": "shadelab",
    "version": "0.1.0",
    "scheme": "shadelab",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shadelab.app",
      "infoPlist": {
        "NSCameraUsageDescription": "O Cypris Smile usa a câmera para fotografar o sorriso, o dente e a escala de cor.",
        "NSPhotoLibraryUsageDescription": "O Cypris Smile acessa suas fotos para analisar imagens já capturadas."
      }
    },
    "android": {
      "package": "com.shadelab.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "O Cypris Smile usa a câmera para fotografar o sorriso, o dente e a escala de cor."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Cypris Smile acessa suas fotos para analisar imagens já capturadas."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Cypris Smile usa o Face ID para você entrar sem digitar a senha."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35123588-021a-48a9-a226-8f0861c35600"
      }
    },
    "owner": "gustavosaints",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/35123588-021a-48a9-a226-8f0861c35600"
    }
  }
}
